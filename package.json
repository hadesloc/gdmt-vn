{
  "name": "gdmt-vn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GDMT-VN – Phác đồ điều trị nội khoa tối ưu (GDMT) 9 bệnh mạn tính",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run verify:kb",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "trial": "powershell.exe -NoProfile -File tools/startTrial.ps1",
    "test:e2e": "tsx tools/e2e/internalTrial.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:kb": "tsx tools/kb/verifyKb.ts",
    "kb:search": "tsx tools/kb/quoteSearch.ts",
    "kb:review": "tsx tools/kb/aiReview.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@noble/hashes": "2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.50.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
